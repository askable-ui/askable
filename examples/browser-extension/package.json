{
  "name": "@askable-ui/example-browser-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && vite build --config vite.content.config.ts && npm run test:build",
    "test": "npm run build",
    "test:build": "node --test tests/build.test.mjs",
    "test:browser": "playwright test --config playwright.config.mjs"
  },
  "dependencies": {
    "@askable-ui/bridge": "^0.17.2",
    "@askable-ui/core": "^0.17.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.8",
    "@types/node": "^22.10.2",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  }
}
